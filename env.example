# Cadeia de conexão do PostgreSQL em nuvem (Neon, Supabase, Vercel Postgres...).
# Na Vercel, use a URL "pooled"/"pooler" do provedor.
DATABASE_URL=postgres://usuario:senha@host:5432/natus?sslmode=require

# Opcionais
SESSION_HOURS=12     # validade da sessão (horas)
PG_POOL_MAX=3        # conexões por instância serverless

# Somente para `npm run db:seed` (primeira instalação)
ADMIN_NOME=admin
ADMIN_SENHA=troque-esta-senha
SEED_LEITOS=0        # leitos de exemplo por setor (0 = nenhum)
